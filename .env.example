# ==============================================================================
# MediFlow — AI-Powered Clinic Management SaaS Configuration
# ==============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key

# 2. Database Storage Mode & Supabase PostgreSQL
# Options: 'memory' (in-memory mock for dev/test) | 'supabase' (persistent PostgreSQL)
# In production (NODE_ENV=production), 'supabase' is strictly mandatory.
DATA_STORAGE_MODE=memory
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Application Envelope Encryption (KMS)
# Used to encrypt sensitive digital patient intake responses (AES-256-GCM)
KMS_DATA_KEY=replace_with_32_byte_hex_or_cloud_kms_arn

# 4. Twilio Integration (SMS & Automated Voice Reminders)
# When left unset, MediFlow falls back to the labeled development mock notification logger
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+447700900000

# 5. Google Calendar API (Doctor Availability & Appointment Sync)
# When left unset, MediFlow falls back to the labeled development mock calendar adapter
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# 6. Stripe Billing (SaaS Clinic Subscriptions)
# When left unset or prefixed with 'mock_', simulated Stripe checkout test flow is used
STRIPE_SECRET_KEY=sk_test_51XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_51XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 7. WebRTC Telemedicine Coturn / TURN Infrastructure (NAT Traversal)
# Unset in dev falls back to public STUN. Mandatory for enterprise/NHS firewall traversal.
TURN_SERVER_URL=turns:turn.yourclinicdomain.com:5349
TURN_USERNAME=mediflow_telemedicine_user
TURN_CREDENTIAL=replace_with_secure_turn_secret_token

# 8. Frontend Vite Configuration
VITE_API_URL=http://localhost:5000/api
VITE_WS_SIGNALING_URL=ws://localhost:5000/ws/signaling
